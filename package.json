{
  "name": "Decentraland",
  "private": true,
  "version": "1.22.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build-ui": "tsc && vite build",
    "build-core": "tauri build",
    "build": "npm run build-ui && npm run build-core",
    "preview": "vite preview",
    "tauri": "tauri",
    "format-ui": "npx prettier --write '**/*.{js,mjs,cjs,jsx,ts,ODmts,cts,tsx}'",
    "format-tauri": "cd src-tauri && cargo fmt -- --check --verbose",
    "format-core": "cd core && cargo fmt -- --check --verbose",
    "format-installer-hooks": "cd installer-hooks && cargo fmt -- --check --verbose",
    "format-src-shared": "cd src-shared && cargo fmt -- --check --verbose",
    "format-src-ipc": "cd src-ipc && cargo fmt -- --check --verbose",
    "format-src-service": "cd src-service && cargo fmt -- --check --verbose",
    "format-tests-e2e": "cd tests-e2e && cargo fmt -- --check --verbose",
    "format": "npm run format-ui && npm run format-tauri && npm run format-core && npm run format-src-shared && npm run format-src-ipc && npm run format-src-service && npm run format-tests-e2e && npm run format-installer-hooks",
    "analyze-tauri": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "analyze-core": "cd core && cargo clippy --all-targets --all-features -- -D warnings",
    "analyze-installer-hooks": "cd installer-hooks && cargo clippy --all-targets --all-features -- -D warnings",
    "analyze-src-shared": "cd src-shared && cargo clippy --all-targets --all-features -- -D warnings",
    "analyze-src-ipc": "cd src-ipc && cargo clippy --all-targets --all-features -- -D warnings",
    "analyze-src-service": "cd src-service && cargo clippy --all-targets --all-features -- -D warnings",
    "analyze-tests-e2e": "cd tests-e2e && cargo clippy --all-targets --all-features -- -D warnings",
    "analyze": "npm run analyze-tauri && npm run analyze-core && npm run analyze-src-shared && npm run analyze-src-ipc && npm run analyze-src-service && npm run analyze-tests-e2e && npm run analyze-installer-hooks",
    "test-unit-tauri": "cd src-tauri && cargo test --lib",
    "test-unit-core": "cd core && cargo test --lib --bins",
    "test-unit-installer-hooks": "cd installer-hooks && cargo test --bins",
    "test-unit-src-shared": "cd src-shared && cargo test --lib",
    "test-unit-src-ipc": "cd src-ipc && cargo test --lib",
    "test-unit-src-service": "cd src-service && cargo test --bins",
    "test-unit-tests-e2e": "cd tests-e2e && cargo test --lib",
    "test-unit": "npm run test-unit-tauri && npm run test-unit-core && npm run test-unit-installer-hooks && npm run test-unit-src-shared && npm run test-unit-src-ipc && npm run test-unit-src-service && npm run test-unit-tests-e2e",
    "test-integration": "npm run e2e",
    "test": "npm run test-unit",
    "test-all": "npm run test-unit && npm run test-integration",
    "e2e": "rust-script scripts/run-e2e.rs",
    "build-local": "rust-script scripts/build-local.rs"
  },
  "dependencies": {
    "@sentry/react": "^8.29.0",
    "@sentry/vite-plugin": "^2.22.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.2.1",
    "@tauri-apps/plugin-process": "^2.2.1",
    "@tauri-apps/plugin-updater": "^2.7.0",
    "decentraland-ui2": "^0.12.1",
    "path": "^0.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.8",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}